{
  "entrypoint": {
    "input_path": "inputs/real.wav",
    "output_path": "outputs",
    "sample_rate": 16000
  },
  "runtime": {
    "dry_run": false,
    "backend": "local"
  },
  "logging": {
    "log_dir": "logs",
    "progress_bar": true
  },
  "vad": {
    "backend": "silero",
    "model": "silero_vad",
    "threshold": 0.2,
    "min_duration_seconds": 0.15,
    "merge_gap_seconds": 0.2
  },
  "diarization": {
    "backend": "pixit",
    "model": "pyannote/speech-separation-ami-1.0",
    "token_env": "HUGGINGFACE_TOKEN",
    "device": "auto",
    "nemo_log_level": "ERROR",
    "min_duration_seconds": 0.25,
    "max_chunk_seconds": 180.0
  },
  "asr": {
    "enabled": false,
    "asr_backend": "local",
    "backend": "phowhisper_local",
    "model": "vinai/PhoWhisper-large",
    "language": "vi",
    "device": "cpu",
    "chunk_length_seconds": 30.0,
    "kaggle": {
      "dataset_slug": "ngocbaotrinhtuan/vilier-asr-bundle",
      "kernel_slug": "ngocbaotrinhtuan/vilier-phowhisper-asr",
      "accelerator": "NvidiaTeslaT4",
      "work_dir": ".kaggle_asr_work",
      "poll_seconds": 30,
      "max_wait_seconds": 21600,
      "dataset_ready_seconds": 240
    }
  },
  "kaggle": {
    "dataset_slug": "ngocbaotrinhtuan/vilier-pipeline-bundle",
    "kernel_slug": "ngocbaotrinhtuan/vilier-gpu-pipeline",
    "accelerator": "NvidiaTeslaT4",
    "work_dir": ".kaggle_pipeline_work",
    "poll_seconds": 30,
    "max_wait_seconds": 21600,
    "dataset_ready_seconds": 240
  },
  "state_labeling": {
    "enabled": false,
    "backend": "qwen",
    "model": "qwen3.8-max",
    "base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "DASHSCOPE_API_KEY",
    "state_dir": "state",
    "labels": ["complete", "incomplete"]
  },
  "export": {
    "write_segment_wavs": false,
    "write_visualizations": false
  },
  "overlap": {
    "threshold_seconds": 0.05
  },
  "music_separation": {
    "enabled": false,
    "backend": "demucs",
    "model": "htdemucs",
    "device": "cpu",
    "shifts": 1,
    "split": true,
    "overlap": 0.25,
    "residual_subtract": 0.5
  },
  "overlap_separation": {
    "enabled": false,
    "backend": "sepreformer",
    "sepreformer_path": "SepReformer",
    "model_name": "SepReformer_Base_WSJ0",
    "device": "cpu",
    "overlap_threshold_seconds": 0.2
  }
}
