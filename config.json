{
  "entrypoint": {
    "input_path": "inputs/real.wav",
    "output_path": "outputs",
    "sample_rate": 16000
  },
  "runtime": {
    "dry_run": false
  },
  "logging": {
    "log_dir": "logs",
    "progress_bar": true
  },
  "vad": {
    "backend": "silero",
    "model": "silero_vad",
    "threshold": 0.2,
    "min_duration_seconds": 0.15,
    "merge_gap_seconds": 0.2
  },
  "diarization": {
    "backend": "pyannote",
    "model": "pyannote/speaker-diarization-community-1",
    "token_env": "HUGGINGFACE_TOKEN",
    "device": "auto",
    "nemo_log_level": "ERROR",
    "min_duration_seconds": 0.25,
    "max_chunk_seconds": 180.0
  },
  "asr": {
    "enabled": false,
    "backend": "phowhisper_local",
    "model": "vinai/PhoWhisper-large",
    "language": "vi",
    "device": "auto",
    "chunk_length_seconds": 30.0
  },
  "state_labeling": {
    "enabled": false,
    "backend": "qwen",
    "model": "qwen3.8-max",
    "base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "DASHSCOPE_API_KEY",
    "state_dir": "state",
    "labels": [
      "complete",
      "incomplete"
    ]
  },
  "export": {
    "write_segment_wavs": false,
    "write_visualizations": false
  },
  "overlap": {
    "threshold_seconds": 0.05
  },
  "music_separation": {
    "enabled": false,
    "backend": "demucs",
    "model": "htdemucs",
    "device": "auto",
    "shifts": 1,
    "split": true,
    "overlap": 0.25,
    "residual_subtract": 0.5
  },
  "overlap_separation": {
    "enabled": true,
    "backend": "speechbrain",
    "model_name": "speechbrain/sepformer-wsj02mix",
    "device": "auto",
    "overlap_threshold_seconds": 0.2
  }
}
